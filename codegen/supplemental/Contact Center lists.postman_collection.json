{
  "info": {
    "name": "Webex Contact Center",
    "description": "Hand-maintained. Contact Center list routes that Webex still serves but Cisco's Postman collection replaced with newer versions. Webex Admin Studio reads these; see codegen/supplemental/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Site",
      "item": [
        {
          "name": "List Site(s) (v1)",
          "request": {
            "method": "GET",
            "description": "Lists sites with every field, through the v1 route. Each item carries lastUpdatedTime.",
            "url": {
              "raw": "{{baseUrl}}/organization/:orgid/site?page=0&pageSize=100",
              "host": ["{{baseUrl}}"],
              "path": ["organization", ":orgid", "site"],
              "query": [
                {"key": "page", "value": "0", "description": "Page number, from 0."},
                {"key": "pageSize", "value": "100", "description": "Items per page."}
              ],
              "variable": [{"key": "orgid", "description": "Organization ID."}]
            }
          }
        }
      ]
    },
    {
