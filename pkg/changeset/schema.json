{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cloverhound/webex-cli/pkg/changeset/schema.json",
  "title": "Webex change set",
  "description": "Proposed Webex configuration changes, addressed by API route, Webex ID and API JSON path.",
  "type": "object",
  "required": ["format", "metadata", "scope", "operations"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "webex-changeset/v1" },
    "metadata": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "description": "Why, in plain words." },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["agent", "human"] },
            "id": { "type": "string" },
            "onBehalfOf": { "type": "string" }
          }
        },
        "links": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "required": ["orgId"],
      "additionalProperties": false,
      "properties": {
        "orgId": { "type": "string", "minLength": 1, "description": "The org's UUID." }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Facts about an exported change set. Not enforced on import.",
      "properties": {
        "plan": {
          "type": "object",
          "required": ["hash"],
          "additionalProperties": false,
          "properties": {
            "hash": { "type": "string" },
            "commit": { "type": "string" },
            "plannedAt": { "type": "string", "format": "date-time" }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["by", "at"],
            "additionalProperties": false,
            "properties": {
              "by": { "type": "string" },
              "at": { "type": "string", "format": "date-time" },
              "hash": { "type": "string" },
              "comment": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["id", "action", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "intent": { "type": "string" },
        "action": { "enum": ["create", "update", "delete", "invoke"] },
        "handle": { "type": "string", "description": "A create's name for its new object; other operations refer to its ID with {\"$ref\": handle}." },
        "target": { "$ref": "#/$defs/target" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "body": { "description": "A create's or invoke's request body." },
        "method": { "type": "string", "description": "An invoke's HTTP method." }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "create" } } }, "then": { "required": ["handle", "body"], "properties": { "body": { "type": "object" } } } },
        { "if": { "properties": { "action": { "const": "update" } } }, "then": { "required": ["changes"], "properties": { "changes": { "minItems": 1 } } } },
        { "if": { "properties": { "action": { "const": "invoke" } } }, "then": { "required": ["method"] } }
      ]
    },
    "target": {
      "type": "object",
      "required": ["api", "route"],
      "additionalProperties": false,
      "properties": {
        "api": { "enum": ["webex", "cc"], "description": "webex: https://webexapis.com/v1. cc: the Contact Center API, with routes relative to /organization/{orgId}." },
        "route": { "type": "string", "pattern": "^/", "description": "API route template. An update or delete names the object, ending with its ID placeholder; a create names the collection." },
        "params": { "type": "object", "additionalProperties": { "type": "string" }, "description": "A value for every placeholder in route." },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "display": { "type": "string", "description": "A label for people." }
      }
    },
    "change": {
      "type": "object",
      "required": ["path", "value"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^[^.]+(\\.[^.]+)*$", "description": "Dotted path into the object's API JSON. Lists are replaced whole." },
        "before": { "description": "The value the author saw; a precondition. null means absent." },
        "value": { "description": "The new value. {\"$ref\": handle} anywhere means the ID of an object this change set creates." }
      }
    }
  }
}
